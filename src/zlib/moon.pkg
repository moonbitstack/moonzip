// zlib, RFC 1950: https://www.rfc-editor.org/rfc/rfc1950
//
// Two header bytes, a DEFLATE stream and an Adler-32. This is what HTTP's
// `Content-Encoding: deflate` was specified to mean.
import {
  "moonbitstack/moonzip",
  "moonbitstack/moonzip/deflate",
}

import {
  "moonbitstack/moonzip/zlib",
  "moonbitlang/core/compress/zlib" @szlib,
} for "test"

// The standard library's zlib, used by the tests as the other reference.

options(
  "allow-experimental-packages": [ "moonbitlang/core/compress/zlib" ],
)
