///|
/// Archives written by 7-Zip itself, pinned as they came out.
///
///     python3 scripts/sevenzip_interop.py
///
/// regenerates this file. Python's `zipfile` cannot write WinZip AES and
/// does not do volumes, so `scripts/interop.py` cannot produce these;
/// 7-Zip can, and an archive written by a different tool is the only
/// evidence that a reader was not written against its own output.

///|
fn seven_zip(name : String) -> Bytes {
  if name == "plain" {
    return @base16.decode_lossy(
      "",
    )
  }
  if name == "aes128" {
    return @base16.decode_lossy(
      "",
    )
  }
  if name == "aes256" {
    return @base16.decode_lossy(
      "",
    )
  }
  abort("no pinned archive named \{name}")
}

///|
/// The volume set 7-Zip wrote, in the order its names put them.
fn seven_zip_volumes() -> Array[Bytes] {
  [
    @base16.decode_lossy(
      "",
    ),
  ]
}

///|
/// What every one of those archives holds. 7-Zip records the directory
/// `two/` as a member of its own, so the members are looked up by name
/// rather than counted: a reader that dropped one would still see three.
fn seven_zip_check(archive : Bytes, password : String?) -> Unit raise {
  let members = match password {
    Some(secret) => @zip.unzip(archive[:], password=secret)
    None => @zip.unzip(archive[:])
  }
  let mut found = 0
  for entry in members {
    match entry.name {
      "one.txt" => {
        assert_eq(entry.data, b"the first member")
        found += 1
      }
      "two/three.txt" => {
        assert_eq(entry.data, b"the second member")
        found += 1
      }
      _ => ()
    }
  }
  assert_eq(found, 2)
}

///|
test {
  seven_zip_check(seven_zip("plain"), None)
  seven_zip_check(seven_zip("aes128"), Some("moonzip"))
  seven_zip_check(seven_zip("aes256"), Some("moonzip"))
  // The volume set, joined in the order 7-Zip's names put it in.
  seven_zip_check(@zip.join(seven_zip_volumes()), Some("moonzip"))
}
