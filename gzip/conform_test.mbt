///|
fn raw(s : String) -> Bytes {
  @base16.decode_lossy(s)
}

///|
fn hex(b : Bytes) -> String {
  @base16.encode(b[:])
}

///|
/// The seven inputs every vector below is taken over: nothing, one byte, a long
/// run, text with a periodic tail, incompressible noise, a short cycle, and
/// seventy kilobytes — past the 32 KiB window, which is where a back-reference
/// that reaches too far would show.
fn sample(kind : Int) -> Bytes {
  let out : Array[Byte] = []
  match kind {
    0 => ()
    1 => out.push(b'a')
    2 =>
      for _ in 0..<1000 {
        out.push(b'a')
      }
    3 =>
      for i in 0..<500 {
        for b in "the quick brown fox jumps over the lazy dog. " {
          out.push((b.to_int() % 256).to_byte())
        }
        out.push((i % 251).to_byte())
      }
    4 =>
      for i in 0..<3000 {
        out.push((i * 71 % 251).to_byte())
      }
    5 =>
      for i in 0..<2000 {
        out.push((i % 4).to_byte())
      }
    _ =>
      for i in 0..<70000 {
        out.push((i % 13).to_byte())
      }
  }
  Bytes::from_array(out)
}

///|
/// What our compressor writes. Every one of these was handed to zlib, which got
/// the input back — so this table says the output is readable by others, not
/// merely by us.
test "zlib reads what we write" {
  let cases = [
    (0, "0300"),
    (1, "4b0400"),
    (2, "4b1c05a360140c7b0000"),
    (
      3, "",
    ),
    (
      4, "",
    ),
    (5, "636064621ec5a378148fe2513c8a47f1d0c600"),
    (
      6, "",
    ),
  ]
  for case in cases {
    let (kind, want) = case
    let source = sample(kind)
    assert_eq(hex(@deflate.deflate(source[:])), want)
    assert_eq(@deflate.inflate(raw(want)[:]), source)
  }
}

///|
/// The same, in the two containers.
test "the containers, as others read them" {
  let gzipped = [
    (0, "1f8b08000000000000ff03000000000000000000"),
    (1, "1f8b08000000000000ff4b040043beb7e801000000"),
    (2, "1f8b08000000000000ff4b1c05a360140c7b000003da389ae8030000"),
    (
      3, "",
    ),
    (
      4, "",
    ),
    (
      5, "1f8b08000000000000ff636064621ec5a378148fe2513c8a47f1d0c600556be5cdd0070000",
    ),
    (
      6, "",
    ),
  ]
  for case in gzipped {
    let (kind, want) = case
    let source = sample(kind)
    assert_eq(hex(@gzip.gzip(source[:])), want)
    assert_eq(@gzip.gunzip(raw(want)[:]), source)
  }
  let zlibbed = [
    (0, "7801030000000001"),
    (1, "78014b040000620062"),
    (2, "78014b1c05a360140c7b0000f9d87af8"),
    (
      3, "",
    ),
    (
      4, "",
    ),
    (5, "7801636064621ec5a378148fe2513c8a47f1d0c600cd4b0bb9"),
    (
      6, "",
    ),
  ]
  for case in zlibbed {
    let (kind, want) = case
    let source = sample(kind)
    assert_eq(hex(@zlib.zlib(source[:])), want)
    assert_eq(@zlib.unzlib(raw(want)[:]), source)
  }
}

///|
/// What others write, which is where dynamic Huffman comes in: our encoder
/// never emits one, and almost every stream in the world is one.
test "we read what zlib writes" {
  let cases = [
    (0, "0300"),
    (0, "0300"),
    (0, "0300"),
    (0, "010000ffff"),
    (1, "4b0400"),
    (1, "4b0400"),
    (1, "4b0400"),
    (1, "010100feff61"),
    (2, "4b4c1c05a321301a02c33d0400"),
    (2, "4b4c1c05a360140c770000"),
    (2, "4b4c1c05a360140c770000"),
    (
      2, "",
    ),
    (
      3, "",
    ),
    (
      3, "",
    ),
    (
      3, "",
    ),
    (
      4, "",
    ),
    (
      4, "",
    ),
    (
      4, "",
    ),
    (5, "636064626618c5a361309a0646d3c0681a184d03a3696048a70100"),
    (5, "636064626618c5a378148fe2513c8a47f190c600"),
    (5, "636064626618c5a378148fe2513c8a47f190c600"),
    (
      6, "",
    ),
    (
      6, "",
    ),
    (
      6, "",
    ),
  ]
  for case in cases {
    let (kind, stream) = case
    assert_eq(@deflate.inflate(raw(stream)[:]), sample(kind))
  }
}

///|
/// Containers written by others, including a gzip stream carrying a file name —
/// the header field our own writer leaves out and every reader must skip.
test "we read containers others wrote" {
  let cases = [
    (0, "1f8b08000000000002ff03000000000000000000"),
    (0, "78da030000000001"),
    (1, "1f8b08000000000002ff4b040043beb7e801000000"),
    (1, "78da4b040000620062"),
    (2, "1f8b08000000000002ff4b4c1c05a360140c77000003da389ae8030000"),
    (2, "78da4b4c1c05a360140c770000f9d87af8"),
    (
      3, "",
    ),
    (
      3, "",
    ),
    (
      4, "",
    ),
    (
      4, "",
    ),
    (
      5, "1f8b08000000000002ff636064626618c5a378148fe2513c8a47f190c600556be5cdd0070000",
    ),
    (5, "78da636064626618c5a378148fe2513c8a47f190c600cd4b0bb9"),
    (
      6, "",
    ),
    (
      6, "",
    ),
  ]
  let mut which = 0
  for case in cases {
    let (kind, stream) = case
    let source = sample(kind)
    if which % 2 == 0 {
      assert_eq(@gzip.gunzip(raw(stream)[:]), source)
    } else {
      assert_eq(@zlib.unzlib(raw(stream)[:]), source)
    }
    which += 1
  }
}

///|
/// The two checksums, against the values zlib computes.
test "the checksums" {
  let crcs = [
    ("", 0x00000000U),
    ("68656c6c6f", 0x3610A686U),
    (
      "54686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f67",
      0x414FA339U,
    ),
    ("313233343536373839", 0xCBF43926U),
  ]
  for case in crcs {
    let (text, want) = case
    assert_eq(@gzip.crc32(raw(text)[:]), want)
  }
  let adlers = [
    ("", 0x00000001U),
    ("68656c6c6f", 0x062C0215U),
    (
      "54686520717569636b2062726f776e20666f78206a756d7073206f76657220746865206c617a7920646f67",
      0x5BDC0FDAU,
    ),
    ("313233343536373839", 0x091E01DEU),
  ]
  for case in adlers {
    let (text, want) = case
    assert_eq(@zlib.adler32(raw(text)[:]), want)
  }
}

///|
/// What a reader must refuse rather than return something plausible for.
test "a broken stream is refused" {
  let body = @gzip.gzip(b"hello"[:])
  // A corrupted payload fails its checksum.
  let bent = body.to_array()
  bent[12] = (bent[12].to_int() ^ 0xFF).to_byte()
  try @gzip.gunzip(Bytes::from_array(bent)[:]) |> ignore catch {
    _ => ()
  } noraise {
    _ => fail("a corrupted gzip stream was accepted")
  }
  // A truncated one runs out of bits.
  try @gzip.gunzip(body[0:body.length() - 3]) |> ignore catch {
    _ => ()
  } noraise {
    _ => fail("a truncated gzip stream was accepted")
  }
  // Not gzip at all.
  try @gzip.gunzip(b"not a gzip stream at all, no"[:]) |> ignore catch {
    e => assert_true(e is @moonzip.Header(_))
  } noraise {
    _ => fail("arbitrary bytes were read as gzip")
  }
  // A zlib header whose check bits do not add up.
  let z = @zlib.zlib(b"hello"[:]).to_array()
  z[1] = (z[1].to_int() ^ 1).to_byte()
  try @zlib.unzlib(Bytes::from_array(z)[:]) |> ignore catch {
    e => assert_true(e is @moonzip.Header(_))
  } noraise {
    _ => fail("a bad zlib header was accepted")
  }
  // A back-reference that reaches before the start of the output.
  try @deflate.inflate(raw("0302")[:]) |> ignore catch {
    _ => ()
  } noraise {
    _ => fail("a distance past the start was accepted")
  }
  // A block type DEFLATE does not define.
  try @deflate.inflate(raw("07")[:]) |> ignore catch {
    e => assert_true(e is @moonzip.Header(_) || e is @moonzip.Truncated(_))
  } noraise {
    _ => fail("block type 3 was accepted")
  }
}

///|
/// A compressible body must actually come out smaller, or the compressor is
/// only a container.
test "compression compresses" {
  let text = sample(3)
  assert_true(@deflate.deflate(text[:]).length() * 4 < text.length())
  let run = sample(2)
  assert_true(@deflate.deflate(run[:]).length() < 20)
  // Noise cannot be compressed, and must not be inflated much either.
  let noise = sample(4)
  assert_true(@deflate.deflate(noise[:]).length() < noise.length() * 2)
}
