name = "moonbitstack/moonzip"

version = "0.3.5"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonzip"

license = "Apache-2.0"

keywords = [
  "compression",
  "decompression",
  "archive",
  "zip",
  "gzip",
  "deflate",
  "zlib",
  "brotli",
  "bzip2",
  "lz4",
  "lzma",
  "xz",
  "zstd",
  "zstandard",
  "snappy",
  "tar",
  "7z",
  "7zip",
  "rfc1950",
  "rfc1951",
  "rfc1952",
  "rfc7932",
  "rfc8878",
  "moonbit",
]

description = "Compression and archives for MoonBit, one format per package."

import {
  "moonbitstack/moonbase@0.4.2",
  "moonbitstack/mooncrypt@0.4.7",
}

source = "src"
