name = "moonbitstack/moonzip"

version = "0.4.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonzip"

license = "Apache-2.0"

keywords = [
  "deflate",
  "gzip",
  "zlib",
  "zip",
  "tar",
  "lz4",
  "snappy",
  "compression",
  "moonbit",
]

description = "moonzip — compression and archives for MoonBit: deflate, gzip, zlib, zip, tar, lz4 and snappy, one format to a package."

import {
  "moonbitstack/moonbase@0.4.0",
}
