name = "moonbitstack/moonzip"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonzip"

license = "Apache-2.0"

keywords = [ "deflate", "gzip", "zlib", "compression", "inflate", "moonbit" ]

description = "moonzip — compression for MoonBit: DEFLATE and gzip, one algorithm to a package."

preferred_target = "wasm-gc"

import {
  "moonbitstack/moonbase@0.4.0",
}
