name = "moonbitstack/moonzip"

version = "0.6.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonzip"

license = "Apache-2.0"

keywords = [
  "deflate",
  "gzip",
  "zlib",
  "zip",
  "tar",
  "lz4",
  "snappy",
  "lzma",
  "xz",
  "bzip2",
  "7z",
  "compression",
  "moonbit",
]

description = "moonzip — compression and archives for MoonBit: deflate, gzip, zlib, zip, tar, lz4, snappy, lzma, xz, bzip2 and 7z, one format to a package."

import {
  "moonbitstack/moonbase@0.4.0",
}
